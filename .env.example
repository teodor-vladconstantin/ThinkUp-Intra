# Copy to .env.local and fill in. Never commit .env.local.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Clerk (Phase 1) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Supabase (Phase 1) ---
# New key format (sb_publishable_... / sb_secret_...). Legacy anon/service_role keys are being deprecated.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS. Used only in src/lib/supabase/admin.ts.
SUPABASE_SECRET_KEY=
# Postgres connection string (Supabase -> Connect -> Session pooler). Only for bun run rls:check.
SUPABASE_DB_URL=

# --- Resend + cron (Phase 2) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_SECRET=
